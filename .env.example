# Copy thanh ".env" (production) hoac ".env.development" (dev) roi dien gia tri that.
# KHONG commit file chua secret that.

# ═══════════════════════════════════════════════════════════════
# PROJECT (quy tac [PP][SS])
# ═══════════════════════════════════════════════════════════════
PROJECT_NAME=travelphoto
PROJECT_CODE=83
WEB_PORT=8300
API_PORT=8310
REDIS_DB=3

# ═══════════════════════════════════════════════════════════════
# SERVER
# ═══════════════════════════════════════════════════════════════
SERVER_PORT=8310
APP_TIMEZONE=Asia/Ho_Chi_Minh

# ═══════════════════════════════════════════════════════════════
# DATABASE
# ═══════════════════════════════════════════════════════════════
DB_URL=jdbc:mysql://<host>:3306/<db_name>?allowPublicKeyRetrieval=true&useSSL=false
DB_USERNAME=<db_user>
DB_PASSWORD=<db_password>
DB_POOL_SIZE=10
DB_MIN_IDLE=2

# ═══════════════════════════════════════════════════════════════
# JPA
# ═══════════════════════════════════════════════════════════════
JPA_DDL_AUTO=validate
JPA_SHOW_SQL=false

# ═══════════════════════════════════════════════════════════════
# JWT  (sinh bang: openssl rand -base64 32)
# ═══════════════════════════════════════════════════════════════
JWT_SECRET=<random-base64-32-bytes>
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000

# ═══════════════════════════════════════════════════════════════
# UPLOAD / LOGGING / ACTUATOR / SCHEDULING
# ═══════════════════════════════════════════════════════════════
UPLOAD_AVATAR_DIR=uploads/avatars
UPLOAD_MAX_FILE_SIZE=5MB
UPLOAD_MAX_REQUEST_SIZE=6MB
LOG_LEVEL_APP=DEBUG
LOG_LEVEL_SECURITY=WARN
LOG_LEVEL_SQL=WARN
LOG_FILE=logs/travelphoto-api.log
ACTUATOR_ENDPOINTS=health,info
SCHEDULER_POOL_SIZE=2

# ═══════════════════════════════════════════════════════════════
# STORAGE
# ═══════════════════════════════════════════════════════════════
# Dev (chay local): STORAGE_ROOT_PATH = thu muc that tren may dev.
# Production (Docker): STORAGE_ROOT_PATH PHAI la /data/photo-storage (trong container),
# duong dan that tren server dat o STORAGE_HOST_PATH.
STORAGE_ROOT_PATH=D:/path/to/photo
# STORAGE_HOST_PATH=/path/on/server/photo

# ═══════════════════════════════════════════════════════════════
# GOOGLE OAUTH2
# ═══════════════════════════════════════════════════════════════
GOOGLE_CLIENT_ID=<google-client-id>
GOOGLE_CLIENT_SECRET=<google-client-secret>

# ═══════════════════════════════════════════════════════════════
# VNPAY (dien khi da co tai khoan merchant tu VNPay — sandbox hoac production)
# Dang ky sandbox: https://sandbox.vnpayment.vn/devreg
# Production can ho so doanh nghiep, dang ky qua VNPay Merchant Portal.
# ═══════════════════════════════════════════════════════════════
VNPAY_TMN_CODE=<vnpay-tmn-code>
VNPAY_HASH_SECRET=<vnpay-hash-secret>
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:5173/payment/vnpay-return

# ═══════════════════════════════════════════════════════════════
# URL (dev)
# ═══════════════════════════════════════════════════════════════
FRONTEND_URL=http://localhost:8300
API_BASE_URL=http://localhost:8310
COOKIE_SECURE=false
DEV_LOGIN_ENABLED=true
DEV_LOGIN_SECRET=<doi-gia-tri-nay>
# Origin frontend dev duoc nhan token dang nhap Google + CORS khi goi API that tu localhost.
# De trong = tat. Chi bat tren server khi can dev tu localhost.
ALLOWED_DEV_ORIGINS=

# ── Production (.env tren server) ──
# SPRING_PROFILES_ACTIVE=prod
# FRONTEND_URL=https://travelphoto.thongtinchinhhieu.site
# API_BASE_URL=https://travelphoto-api.thongtinchinhhieu.site
# COOKIE_SECURE=true
# DEV_LOGIN_ENABLED=false
# STORAGE_HOST_PATH=/media/mos/PhotoStorage/travelphoto/photo
# STORAGE_ROOT_PATH=/data/photo-storage
# VNPAY_PAY_URL=https://vnpayment.vn/paymentv2/vpcpay.html
# VNPAY_RETURN_URL=https://travelphoto.thongtinchinhhieu.site/payment/vnpay-return

# ── Dev override (chay local, sua truc tiep trong .env tren may dev) ──
# SPRING_PROFILES_ACTIVE=dev
# FRONTEND_URL=http://localhost:8300
# API_BASE_URL=http://localhost:8310
# COOKIE_SECURE=false
# DEV_LOGIN_ENABLED=true
# DEV_LOGIN_SECRET=<doi-gia-tri-nay>
# STORAGE_ROOT_PATH=D:/My Project/tripTravel/photo
